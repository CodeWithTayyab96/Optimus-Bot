# ────────────────────────────────────────────────────────────
#  .env — PLACEHOLDER values only.
#
#  Committed as a starter template: every variable the bot reads,
#  no real credentials. The repo is public — NEVER put a live key
#  here. Real values belong in the .env on your server, which
#  `.update` backs up and restores (RUNTIME_BACKUP_PATHS in
#  commands/owner/update.js), so updating never wipes them.
#
#  Everything is optional; the bot starts without them and only
#  the matching command fails. See .env.example for documentation.
# ────────────────────────────────────────────────────────────

# ── AI providers ─────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=

# ── Cloudflare Workers AI ────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Media, sticker and search APIs ───────────────────────────
GIPHY_API_KEY=qnl7ssQChTdPjsKta2Ax2LMaGXz303tq
TENOR_API_KEY=AIzaSyAyimkuYQYF_FXVALexPuGQctUWRURdCYQ
TELEGRAM_BOT_TOKEN=7801479976:AAGuPL0a7kXXBYz6XUSR_ll2SR5V_W6oHl4
OMDB_API_KEY=6e0922b7
TMDB_API_KEY=
NASA_API_KEY=
PIXAZO_API_KEY=
SPORTSDB_KEY=
TRACE_MOE_API_KEY=
NEXORACLE_API_KEY=

# ── YouTube fallback (last resort) ───────────────────────────
# Only used after yt-dlp has already failed. Free tier is 100
# requests/month — a safety net, not a primary source.
RAPIDAPI_KEY=
RAPIDAPI_HOST=youtube-media-downloader.p.rapidapi.com

# ── Free WARP tunnel (for hosts YouTube blocks by IP) ────────
# 1 = enabled. Runs Cloudflare WARP as a local SOCKS5 proxy (no
# root, works in a container). On first start it downloads the
# usque binary, verifies its checksum and registers a free
# Cloudflare account — which accepts Cloudflare's Terms of
# Service on your behalf (see lib/warpProxy.js).
WARP=1
# WARP_PORT=1080
# WARP_HTTP2=1

# ── Optional tuning ──────────────────────────────────────────
# PROXIES=
# YTDLP_EXTRA_ARGS=-6
# FFMPEG_PATH=
# DL_HEALTH_INTERVAL_MS=1200000
# POT_PROVIDER_PORT=4416
# UPDATE_REPO_URL=
# UPDATE_BRANCH=main

# ────────────────────────────────────────────────────────────
#  Credits
#
#  Variable naming and layout follow the conventions of
#  comparable open-source Baileys WhatsApp bots (Knightbot-MD,
#  Shadow-style bots), so settings stay familiar and portable
#  between projects. Structure only — no code was copied.
#
#  No third-party API keys are included, deliberately. If you add
#  a key that came from another project, credit that project here.
#
#  WARP integration: usque by Diniboy1123
#  (github.com/Diniboy1123/usque) — MIT. Built on Cloudflare WARP.
# ────────────────────────────────────────────────────────────
