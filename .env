# ────────────────────────────────────────────────────────────
#  .env — PLACEHOLDER values only. Replace with your own.
#
#  This file is committed as a starter template so a fresh clone
#  has somewhere to put credentials. NEVER put real keys here —
#  the repo is public.
#
#  Your server's own .env (the one with real values) is preserved
#  by `.update`: it is backed up before `git reset --hard` and
#  restored afterwards (see RUNTIME_BACKUP_PATHS in
#  commands/owner/update.js), so updating never wipes it.
#
#  Every value below is optional — the bot starts without them,
#  but the related commands will not work until they are set.
#  See .env.example for the full, documented list.
# ────────────────────────────────────────────────────────────

# ── AI providers ─────────────────────────────────────────────
GROQ_API_KEY=              # .ai / whisper transcription — console.groq.com
GEMINI_API_KEY=            # .ai image generation — aistudio.google.com

# ── Cloudflare Workers AI (image fallback #1) ────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Command-specific keys ────────────────────────────────────
GIPHY_API_KEY=             # .gif — developers.giphy.com
OMDB_API_KEY=              # .imdb — omdbapi.com/apikey.aspx
TENOR_API_KEY=             # .emojimix — console.cloud.google.com (Tenor API)
TELEGRAM_BOT_TOKEN=        # .stickertelegram — create your own with @BotFather

# ── Outbound proxy pool (media downloads) ────────────────────
# Only needed if a host's own IP is fine but you want to route
# elsewhere. A DATACENTER proxy will NOT fix YouTube — those IPs
# are blocked too. Run `.ytdiag` first.
# PROXIES=

# ── RapidAPI YouTube fallback (last resort) ──────────────────
# Only reached when yt-dlp has already failed. FREE TIER IS 100
# REQUESTS/MONTH — a safety net, not a primary source.
RAPIDAPI_KEY=
RAPIDAPI_HOST=youtube-media-downloader.p.rapidapi.com

# ── Free WARP tunnel (for hosts YouTube blocks by IP) ────────
# Set to 1 to enable: runs Cloudflare WARP as a local SOCKS5
# proxy (no root, works in a container). Leave OFF unless
# `.ytdiag` shows every YouTube client is blocked.
WARP=
# WARP_PORT=1080           # only if you need a different local port
# WARP_HTTP2=1             # only if your host blocks UDP (QUIC)

# ── Extra yt-dlp arguments (escape hatch) ────────────────────
# Applied to every yt-dlp call, e.g. force IPv6 when YouTube
# blocks the IPv4 address but not the IPv6 one:
# YTDLP_EXTRA_ARGS=-6
