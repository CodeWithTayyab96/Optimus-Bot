# ────────────────────────────────────────────────────────────
#  .env.example — copy this to .env and fill in your own values.
#
#    cp .env.example .env      (or:  copy /Y .env.example .env)
#
#  .env is gitignored and is where REAL credentials belong.
#  settings.js (committed) reads these variables and falls back
#  to harmless placeholders when one is missing.
#
#  Every value below is optional — the bot starts without them,
#  but the related commands will not work until they are set.
# ────────────────────────────────────────────────────────────

# ── AI providers ─────────────────────────────────────────────
GROQ_API_KEY=            # .ai / whisper transcription — console.groq.com
GEMINI_API_KEY=          # .ai image generation — aistudio.google.com

# ── Cloudflare Workers AI (image fallback #1) ────────────────
# dash.cloudflare.com → Workers AI → Use REST API
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Command-specific keys ────────────────────────────────────
GIPHY_API_KEY=           # .gif — developers.giphy.com
OMDB_API_KEY=            # .imdb — omdbapi.com/apikey.aspx
TENOR_API_KEY=           # .emojimix — console.cloud.google.com (Tenor API)
TELEGRAM_BOT_TOKEN=      # .stickertelegram — create your own with @BotFather

# ── Optional ─────────────────────────────────────────────────
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=        # any OpenAI-compatible endpoint
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-1
# TMDB_API_KEY=          # .tmdb — themoviedb.org/settings/api
# PROXIES=               # comma-separated: http://user:pass@host:port,socks5://host:port

# ── Runtime tuning (optional) ────────────────────────────────
# POT_PROVIDER_DIR=~/bgutil-ytdlp-pot-provider/server
# POT_PROVIDER_PORT=4416
# DL_HEALTH_INTERVAL_MS=1200000
# YTDLP_BIN=yt-dlp
# FFMPEG_PATH=
