{
  "name": "optimusbot",
  "version": "2.3.3",
  "description": "Optimus Bot — WhatsApp Bot",
  "main": "index.js",
  "scripts": {
    "prestart": "node bootstrap.js --deps-only",
    "start": "node index.js",
    "boot": "node bootstrap.js",
    "deps": "node bootstrap.js --deps-only",
    "deps:check": "node bootstrap.js --check",
    "start:optimized": "node --max-old-space-size=512 --optimize-for-size --gc-interval=100 index.js",
    "cleanup": "node cleanup.js",
    "reset-session": "node reset-session.js",
    "pair": "node scripts/pair.js",
    "pair:qr": "node scripts/pair.js --qr",
    "pair:test": "node scripts/test-pairing.js",
    "pair:clean": "node scripts/test-pairing.js --clean",
    "start:clean": "npm run cleanup && npm run start:optimized",
    "start:fresh": "npm run reset-session && npm start",
    "install:panel": "npm install --legacy-peer-deps",
    "install:force": "npm install --force",
    "test": "node scripts/run-tests.js",
    "docker:build": "docker build -t optimusbot ."
  },
  "keywords": [
    "whatsapp-bot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@adiwajshing/keyed-db": "^0.2.4",
    "@distube/ytdl-core": "^4.14.4",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@hapi/boom": "^10.0.1",
    "@types/node": "^18.0.6",
    "@whiskeysockets/baileys": "^v7.0.0-rc.9",
    "awesome-phonenumber": "^5.9.0",
    "axios": "^1.8.4",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "cookie": "^0.5.0",
    "dotenv": "^16.4.5",
    "events": "^3.3.0",
    "ffmpeg-static": "^5.3.0",
    "file-type": "^16.5.4",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.1",
    "fs-extra": "^11.2.0",
    "google-translate-api-x": "^10.7.3",
    "gtts": "^0.2.1",
    "human-readable": "^0.2.1",
    "jimp": "^1.6.0",
    "libphonenumber-js": "^1.11.18",
    "libsignal": "^2.0.1",
    "mammoth": "^1.12.0",
    "moment-timezone": "^0.5.43",
    "mumaker": "^2.0.0",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.7.0",
    "node-id3": "^0.2.3",
    "node-webpmux": "^3.1.0",
    "node-youtube-music": "^0.8.3",
    "pdf-parse": "^2.4.5",
    "performance-now": "^2.1.0",
    "phin": "^3.7.1",
    "pino": "^8.21.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "request": "^2.88.2",
    "ruhend-scraper": "^8.3.0",
    "safe-stable-stringify": "^2.5.0",
    "set-cookie": "^0.0.4",
    "sharp": "^0.32.6",
    "tough-cookie": "^5.0.0",
    "ws": "^8.17.1",
    "yargs": "^17.6.0",
    "yargs-parser": "^21.1.1",
    "youtube-yts": "^2.0.0",
    "yt-search": "^2.12.1"
  },
  "overrides": {
    "jimp": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "jest": "^30.4.2"
  },
  "allowScripts": {
    "@whiskeysockets/baileys@7.0.0-rc13": true,
    "es5-ext@0.10.64": true,
    "ffmpeg-static@5.3.0": true,
    "protobufjs@6.8.8": true,
    "protobufjs@7.6.1": true,
    "sharp@0.32.6": true,
    "unrs-resolver@1.12.2": true
  }
}
