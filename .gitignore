# Dependencies
node_modules/
# NOTE: package-lock.json is deliberately NOT ignored — it pins the whole
# dependency tree so installs are reproducible and `npm ci` can run.

# Runtime data
/tmp/
/temp/

# Runtime state (regenerated by the bot — do not commit)
data/*
!data/.gitkeep
/baileys_store.json

# Session files (WhatsApp credentials — never commit)
/session/

# Environment variables
.env

# User configuration — contains API keys, copy settings.example.js instead.
# Anchored with a leading slash so it does NOT also swallow the legitimate
# command file commands/general/settings.js.
/settings.js

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
