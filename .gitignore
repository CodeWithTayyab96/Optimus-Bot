# Dependencies
node_modules/
# NOTE: package-lock.json is deliberately NOT ignored — it pins the whole
# dependency tree so installs are reproducible and `npm ci` can run.

# Runtime data
/tmp/
/temp/

# Downloaded standalone tools (bootstrap.js fetches yt-dlp here when the host
# has no python/pip)
/.tools/

# Runtime state (regenerated by the bot — do not commit)
data/*
!data/.gitkeep
/baileys_store.json

# Session files (WhatsApp credentials — never commit)
/session/
# Test pairing session (also real credentials — scripts/test-pairing.js writes here)
/.pairtest/
# Session produced by the .pair command (real credentials too)
/session-pair/
# Belt and braces: a stray creds.json anywhere must never be committed.
creds.json

# Environment variables
.env

# User configuration.
# settings.js IS committed — it holds placeholders only, so a fresh clone runs
# without a manual copy step. Real credentials belong in .env (ignored below).
# NOTE: never add a bare `settings.js` rule here — an unanchored pattern matches
# at every depth and would silently swallow commands/general/settings.js.

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
